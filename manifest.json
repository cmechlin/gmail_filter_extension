{
  "manifest_version": 3,
  "key": "",
  "name": "Gmail Filter Manager",
  "version": "0.1.0",
  "description": "Manage Gmail filters and labels from a Chrome side panel.",
  "minimum_chrome_version": "147",
  "permissions": ["sidePanel", "storage", "tabs", "downloads", "identity"],
  "host_permissions": ["https://mail.google.com/*", "https://www.googleapis.com/*", "https://oauth2.googleapis.com/*"],
  "oauth2": {
    "client_id": "382894673505-bqfe09oono4ft754bmbvgilbsl05c3pi.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/gmail.settings.basic",
      "https://www.googleapis.com/auth/gmail.modify",
      "https://www.googleapis.com/auth/userinfo.email"
    ]
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Open Gmail Filter Manager",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["src/content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
